+++ b/auriga/transitions/dispatch-wiring.test.ts
@@ -0,0 +1,82 @@
+import { EventEmitter } from "node:events";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { EventContract } from "../../contracts/event.ts";
+import type { BoardTransitionEvent } from "./index.ts";
+import {
+  toDispatchEvent,
+  wireDispatchEligible,
+  wireReviewEligible,
+  type OnEventConsumer,
+  type ReviewTransitionHandler,
+} from "./dispatch-wiring.ts";
+
+class FakeSubscriber extends EventEmitter {}
+
+class RecordingConsumer implements OnEventConsumer {
+  events: EventContract[] = [];
+
+  async onEvent(event: EventContract): Promise<void> {
+    this.events.push(event);
+  }
+}
+
+class RecordingReviewHandler implements ReviewTransitionHandler {
+  events: BoardTransitionEvent[] = [];
+
+  async onReviewEligible(event: BoardTransitionEvent): Promise<void> {
+    this.events.push(event);
+  }
+}
+
+function transition(overrides: Partial<BoardTransitionEvent> = {}): BoardTransitionEvent {
+  return {
+    issueId: "issue-1",
+    projectId: "project-1",
+    previousStatus: "todo",
+    status: "in_progress",
+    timestamp: "2026-07-27T07:00:00.000Z",
+    coldStart: false,
+    ...overrides,
+  };
+}
+
+test("toDispatchEvent preserves the transitioned issue id as payload.taskId", () => {
+  const event = toDispatchEvent(transition());
+
+  assert.equal(event.type, "task.claimable");
+  assert.deepEqual(event.payload, {
+    taskId: "issue-1",
+    previousStatus: "todo",
+    status: "in_progress",
+    coldStart: false,
+  });
+  assert.equal(event.timestamp, "2026-07-27T07:00:00.000Z");
+  assert.equal(event.source, "auriga-run-board-transition-subscriber");
+});
+
+test("wireDispatchEligible calls consumer.onEvent for dispatch transitions", async () => {
+  const subscriber = new FakeSubscriber();
+  const consumer = new RecordingConsumer();
+
+  wireDispatchEligible(subscriber as never, consumer);
+  subscriber.emit("dispatch-eligible", transition({ issueId: "dispatch-issue" }));
+
+  assert.equal(consumer.events.length, 1);
+  assert.deepEqual((consumer.events[0]!.payload as { taskId: string }).taskId, "dispatch-issue");
+});
+
+test("wireReviewEligible calls the review handler for review transitions", async () => {
+  const subscriber = new FakeSubscriber();
+  const handler = new RecordingReviewHandler();
+  const reviewTransition = transition({
+    issueId: "review-issue",
+    previousStatus: "in_progress",
+    status: "in_review",
+  });
+
+  wireReviewEligible(subscriber as never, handler);
+  subscriber.emit("review-eligible", reviewTransition);
+
+  assert.deepEqual(handler.events, [reviewTransition]);
+});
