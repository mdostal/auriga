+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  BoardTransitionSubscriber,
+  type BoardTransitionSubscriberConfig,
+  type BoardTransitionEvent,
+  type WebSocketConstructorLike,
+} from "./index.ts";
+
+interface FakeIssue {
+  id: string;
+  status: string;
+  project_id?: string;
+}
+
+function issuesResponse(issues: FakeIssue[]): Response {
+  return new Response(JSON.stringify({ issues }), {
+    status: 200,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+class FakeWebSocket {
+  static instances: FakeWebSocket[] = [];
+  onopen: ((event: unknown) => void) | null = null;
+  onmessage: ((event: { data: string }) => void) | null = null;
+  onerror: ((event: unknown) => void) | null = null;
+  onclose: ((event: unknown) => void) | null = null;
+  sent: string[] = [];
+  closed = false;
+
+  constructor(readonly url: string) {
+    FakeWebSocket.instances.push(this);
+  }
+
+  send(data: string): void {
+    this.sent.push(data);
+  }
+
+  close(): void {
+    this.closed = true;
+  }
+
+  open(): void {
+    this.onopen?.({});
+  }
+
+  message(data: unknown): void {
+    this.onmessage?.({ data: JSON.stringify(data) });
+  }
+}
+
+function resetFakeSockets(): void {
+  FakeWebSocket.instances = [];
+}
+
+function baseConfig(
+  overrides: Partial<BoardTransitionSubscriberConfig> = {},
+): BoardTransitionSubscriberConfig {
+  return {
+    serverUrl: "http://fake-multica.test",
+    workspaceId: "ws-1",
+    projectId: "project-1",
+    token: "fake-token",
+    reconnectDelayMs: 1_000,
+    webSocketFactory: FakeWebSocket as unknown as WebSocketConstructorLike,
+    ...overrides,
+  };
+}
+
+test("start loads a one-shot cold-start baseline and emits existing in_progress/in_review work", async (t) => {
+  resetFakeSockets();
+  const requestedUrls: string[] = [];
+  t.mock.method(globalThis, "fetch", async (input: string | URL | Request) => {
+    requestedUrls.push(String(input));
+    return issuesResponse([
+      { id: "dispatch-now", status: "in_progress", project_id: "project-1" },
+      { id: "verify-now", status: "in_review", project_id: "project-1" },
+      { id: "not-ready", status: "todo", project_id: "project-1" },
+      { id: "wrong-project", status: "in_progress", project_id: "project-2" },
+    ]);
+  });
+
+  const subscriber = new BoardTransitionSubscriber(baseConfig());
+  const dispatchEvents: BoardTransitionEvent[] = [];
+  const reviewEvents: BoardTransitionEvent[] = [];
+  subscriber.on("dispatch-eligible", (event: BoardTransitionEvent) => dispatchEvents.push(event));
+  subscriber.on("review-eligible", (event: BoardTransitionEvent) => reviewEvents.push(event));
+
+  await subscriber.start();
+  await subscriber.stop();
+
+  assert.equal(requestedUrls.length, 1, "baseline must be a single GET, not a polling loop");
+  assert.match(requestedUrls[0]!, /\/api\/issues\?workspace_id=ws-1&project_id=project-1$/);
+  assert.deepEqual(dispatchEvents.map((e) => e.issueId), ["dispatch-now"]);
+  assert.deepEqual(reviewEvents.map((e) => e.issueId), ["verify-now"]);
+  assert.equal(dispatchEvents[0]!.coldStart, true);
+  assert.equal(reviewEvents[0]!.coldStart, true);
+});
+
+test("the WebSocket subscription authenticates and consumes todo -> in_progress transition frames immediately", async (t) => {
+  resetFakeSockets();
+  t.mock.method(globalThis, "fetch", async () => issuesResponse([{ id: "issue-1", status: "todo", project_id: "project-1" }]));
+
+  const subscriber = new BoardTransitionSubscriber(baseConfig());
+  const dispatchEvents: BoardTransitionEvent[] = [];
+  subscriber.on("dispatch-eligible", (event: BoardTransitionEvent) => dispatchEvents.push(event));
+
+  await subscriber.start();
+  const socket = FakeWebSocket.instances[0]!;
+  socket.open();
+
+  assert.equal(socket.url, "ws://fake-multica.test/ws?workspace_id=ws-1&client_platform=auriga");
+  assert.deepEqual(JSON.parse(socket.sent[0]!), { type: "auth", payload: { token: "fake-token" } });
+
+  socket.message({
+    type: "issue:updated",
+    payload: {
+      status_changed: true,
+      prev_status: "todo",
+      issue: { id: "issue-1", status: "in_progress", project_id: "project-1" },
+    },
+  });
+  await subscriber.stop();
+
+  assert.equal(dispatchEvents.length, 1);
+  assert.deepEqual(
+    {
+      issueId: dispatchEvents[0]!.issueId,
+      previousStatus: dispatchEvents[0]!.previousStatus,
+      status: dispatchEvents[0]!.status,
+      coldStart: dispatchEvents[0]!.coldStart,
+    },
+    { issueId: "issue-1", previousStatus: "todo", status: "in_progress", coldStart: false },
+  );
+});
+
+test("in_progress -> in_review transition frames drive review eligibility", async (t) => {
+  resetFakeSockets();
+  t.mock.method(globalThis, "fetch", async () =>
+    issuesResponse([{ id: "review-issue", status: "in_progress", project_id: "project-1" }]),
+  );
+
+  const subscriber = new BoardTransitionSubscriber(baseConfig());
+  const reviewEvents: BoardTransitionEvent[] = [];
+  subscriber.on("review-eligible", (event: BoardTransitionEvent) => reviewEvents.push(event));
+
+  await subscriber.start();
+  FakeWebSocket.instances[0]!.message({
+    type: "issue:updated",
+    payload: {
+      status_changed: true,
+      prev_status: "in_progress",
+      issue: { id: "review-issue", status: "in_review", project_id: "project-1" },
+    },
+  });
+  await subscriber.stop();
+
+  assert.equal(reviewEvents.length, 1);
+  assert.equal(reviewEvents[0]!.issueId, "review-issue");
+  assert.equal(reviewEvents[0]!.previousStatus, "in_progress");
+});
+
+test("non-status updates, wrong projects, and duplicate status frames are ignored", async (t) => {
+  resetFakeSockets();
+  t.mock.method(globalThis, "fetch", async () => issuesResponse([{ id: "issue-1", status: "todo", project_id: "project-1" }]));
+
+  const subscriber = new BoardTransitionSubscriber(baseConfig());
+  const transitions: BoardTransitionEvent[] = [];
+  subscriber.on("transition", (event: BoardTransitionEvent) => transitions.push(event));
+
+  await subscriber.start();
+  const socket = FakeWebSocket.instances[0]!;
+  socket.message({
+    type: "issue:updated",
+    payload: {
+      status_changed: false,
+      prev_status: "todo",
+      issue: { id: "issue-1", status: "in_progress", project_id: "project-1" },
+    },
+  });
+  socket.message({
+    type: "issue:updated",
+    payload: {
+      status_changed: true,
+      prev_status: "todo",
+      issue: { id: "wrong-project", status: "in_progress", project_id: "project-2" },
+    },
+  });
+  socket.message({
+    type: "issue:updated",
+    payload: {
+      status_changed: true,
+      prev_status: "todo",
+      issue: { id: "issue-1", status: "in_progress", project_id: "project-1" },
+    },
+  });
+  socket.message({
+    type: "issue:updated",
+    payload: {
+      status_changed: true,
+      prev_status: "todo",
+      issue: { id: "issue-1", status: "in_progress", project_id: "project-1" },
+    },
