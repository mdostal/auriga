+++ b/auriga/transitions/index.ts
@@ -0,0 +1,224 @@
+import { EventEmitter } from "node:events";
+
+export interface BoardTransitionSubscriberConfig {
+  serverUrl: string;
+  workspaceId: string;
+  projectId: string;
+  token: string;
+  reconnectDelayMs?: number;
+  webSocketFactory?: WebSocketConstructorLike;
+}
+
+export interface BoardTransitionEvent {
+  issueId: string;
+  projectId: string;
+  previousStatus: string | undefined;
+  status: string;
+  timestamp: string;
+  coldStart: boolean;
+}
+
+interface MulticaIssue {
+  id: string;
+  status: string;
+  project_id?: string | null;
+}
+
+interface IssueUpdatedPayload {
+  issue?: MulticaIssue;
+  status_changed?: boolean;
+  prev_status?: string;
+}
+
+interface WebSocketMessageEventLike {
+  data: string | Buffer | ArrayBuffer;
+}
+
+interface WebSocketLike {
+  onopen: ((event: unknown) => void) | null;
+  onmessage: ((event: WebSocketMessageEventLike) => void) | null;
+  onerror: ((event: unknown) => void) | null;
+  onclose: ((event: unknown) => void) | null;
+  send(data: string): void;
+  close(): void;
+}
+
+export interface WebSocketConstructorLike {
+  new (url: string): WebSocketLike;
+}
+
+const DEFAULT_RECONNECT_DELAY_MS = 5_000;
+const DISPATCH_TRANSITION = { from: "todo", to: "in_progress" };
+const REVIEW_TRANSITION = { from: "in_progress", to: "in_review" };
+
+function asWsUrl(serverUrl: string, workspaceId: string): string {
+  const base = serverUrl.replace(/\/+$/, "");
+  const protocol = base.startsWith("https://") ? "wss://" : "ws://";
+  const withoutProtocol = base.replace(/^https?:\/\//, "");
+  return `${protocol}${withoutProtocol}/ws?workspace_id=${encodeURIComponent(workspaceId)}&client_platform=auriga`;
+}
+
+function defaultWebSocketFactory(): WebSocketConstructorLike {
+  const candidate = (globalThis as { WebSocket?: WebSocketConstructorLike }).WebSocket;
+  if (!candidate) {
+    throw new Error("BoardTransitionSubscriber: global WebSocket is unavailable; pass webSocketFactory in this runtime");
+  }
+  return candidate;
+}
+
+function messageDataToString(data: WebSocketMessageEventLike["data"]): string {
+  if (typeof data === "string") return data;
+  if (Buffer.isBuffer(data)) return data.toString("utf8");
+  return Buffer.from(data).toString("utf8");
+}
+
+function isEligibleTransition(
+  event: BoardTransitionEvent,
+  expected: { from: string; to: string },
+): boolean {
+  if (event.status !== expected.to) return false;
+  return event.coldStart || event.previousStatus === expected.from;
+}
+
+/**
+ * Subscribes Auriga to Multica's existing workspace realtime bus.
+ *
+ * Startup does one baseline issue-list read for this project so already-in-flight
+ * `in_progress` work and already-reviewable `in_review` work are not missed.
+ * After that, `issue:updated` WebSocket frames are the primary trigger. There
+ * is no recurring issue-list poll loop here.
+ */
+export class BoardTransitionSubscriber extends EventEmitter {
+  readonly #serverUrl: string;
+  readonly #workspaceId: string;
+  readonly #projectId: string;
+  readonly #token: string;
+  readonly #reconnectDelayMs: number;
+  readonly #webSocketFactory: WebSocketConstructorLike;
+  readonly #lastKnownStatus = new Map<string, string>();
+  #socket: WebSocketLike | undefined;
+  #reconnectTimer: NodeJS.Timeout | undefined;
+  #stopped = true;
+
+  constructor(config: BoardTransitionSubscriberConfig) {
+    super();
+    this.#serverUrl = config.serverUrl.replace(/\/+$/, "");
+    this.#workspaceId = config.workspaceId;
+    this.#projectId = config.projectId;
+    this.#token = config.token;
+    this.#reconnectDelayMs = config.reconnectDelayMs ?? DEFAULT_RECONNECT_DELAY_MS;
+    this.#webSocketFactory = config.webSocketFactory ?? defaultWebSocketFactory();
+  }
+
+  async start(): Promise<void> {
+    if (!this.#stopped) return;
+    this.#stopped = false;
+    await this.#loadColdStartBaseline();
+    if (this.#stopped) return;
+    this.#connect();
+  }
+
+  async stop(): Promise<void> {
+    this.#stopped = true;
+    if (this.#reconnectTimer) {
+      clearTimeout(this.#reconnectTimer);
+      this.#reconnectTimer = undefined;
+    }
+    const socket = this.#socket;
+    this.#socket = undefined;
+    socket?.close();
+  }
+
+  async #loadColdStartBaseline(): Promise<void> {
+    const url = `${this.#serverUrl}/api/issues?workspace_id=${encodeURIComponent(this.#workspaceId)}&project_id=${encodeURIComponent(this.#projectId)}`;
+    const res = await fetch(url, {
+      headers: { Authorization: `Bearer ${this.#token}` },
+    });
+    if (!res.ok) {
+      throw new Error(`BoardTransitionSubscriber: GET ${url} -> ${res.status}`);
+    }
+    const body = (await res.json()) as { issues: MulticaIssue[] };
+    for (const issue of body.issues) {
+      if (issue.project_id !== this.#projectId) continue;
+      this.#lastKnownStatus.set(issue.id, issue.status);
+      if (issue.status === DISPATCH_TRANSITION.to || issue.status === REVIEW_TRANSITION.to) {
+        this.#emitTransition({
+          issueId: issue.id,
+          projectId: this.#projectId,
+          previousStatus: undefined,
+          status: issue.status,
+          timestamp: new Date().toISOString(),
+          coldStart: true,
+        });
+      }
+    }
+  }
+
+  #connect(): void {
+    const socket = new this.#webSocketFactory(asWsUrl(this.#serverUrl, this.#workspaceId));
+    this.#socket = socket;
+
+    socket.onopen = () => {
+      socket.send(JSON.stringify({ type: "auth", payload: { token: this.#token } }));
+    };
+    socket.onmessage = (event) => {
+      this.#handleFrame(messageDataToString(event.data));
+    };
+    socket.onerror = (event) => {
+      this.emit("subscription-error", event);
+    };
+    socket.onclose = () => {
+      if (this.#socket === socket) this.#socket = undefined;
+      if (!this.#stopped) this.#scheduleReconnect();
+    };
+  }
+
+  #scheduleReconnect(): void {
+    if (this.#reconnectTimer) return;
+    this.#reconnectTimer = setTimeout(() => {
+      this.#reconnectTimer = undefined;
+      if (!this.#stopped) this.#connect();
+    }, this.#reconnectDelayMs);
+  }
+
+  #handleFrame(raw: string): void {
+    let frame: { type?: string; payload?: IssueUpdatedPayload };
+    try {
+      frame = JSON.parse(raw) as { type?: string; payload?: IssueUpdatedPayload };
+    } catch (error) {
+      this.emit("subscription-error", error);
+      return;
+    }
+
+    if (frame.type !== "issue:updated" || !frame.payload?.status_changed || !frame.payload.issue) {
+      return;
+    }
+
+    const issue = frame.payload.issue;
+    if (issue.project_id !== this.#projectId) return;
+
+    const knownPreviousStatus = this.#lastKnownStatus.get(issue.id);
+    if (knownPreviousStatus === issue.status) return;
+
+    const previousStatus = frame.payload.prev_status ?? knownPreviousStatus;
+    this.#lastKnownStatus.set(issue.id, issue.status);
+    this.#emitTransition({
+      issueId: issue.id,
+      projectId: this.#projectId,
+      previousStatus,
+      status: issue.status,
+      timestamp: new Date().toISOString(),
+      coldStart: false,
+    });
+  }
+
+  #emitTransition(event: BoardTransitionEvent): void {
+    this.emit("transition", event);
+    if (isEligibleTransition(event, DISPATCH_TRANSITION)) {
+      this.emit("dispatch-eligible", event);
+    }
+    if (isEligibleTransition(event, REVIEW_TRANSITION)) {
+      this.emit("review-eligible", event);
+    }
+  }
