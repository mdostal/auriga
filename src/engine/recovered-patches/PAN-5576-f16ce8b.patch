@@ -0,0 +1,55 @@
+import { randomUUID } from "node:crypto";
+import type { EventContract } from "../../contracts/event.ts";
+import type { BoardTransitionEvent, BoardTransitionSubscriber } from "./index.ts";
+
+export interface OnEventConsumer {
+  onEvent(event: EventContract): Promise<void>;
+}
+
+export interface ReviewTransitionHandler {
+  onReviewEligible(event: BoardTransitionEvent): Promise<void>;
+}
+
+export function toDispatchEvent(transition: BoardTransitionEvent): EventContract {
+  return {
+    id: `auriga-run:board-transition:${transition.issueId}:${randomUUID()}`,
+    type: "task.claimable",
+    payload: {
+      taskId: transition.issueId,
+      previousStatus: transition.previousStatus,
+      status: transition.status,
+      coldStart: transition.coldStart,
+    },
+    timestamp: transition.timestamp,
+    source: "auriga-run-board-transition-subscriber",
+  };
+}
+
+export function wireDispatchEligible(
+  subscriber: BoardTransitionSubscriber,
+  consumer: OnEventConsumer,
+): void {
+  subscriber.on("dispatch-eligible", (transition: BoardTransitionEvent) => {
+    const event = toDispatchEvent(transition);
+    console.log(
+      `[transition-dispatch] issueId=${transition.issueId} ${transition.previousStatus ?? "(cold-start)"} -> ${transition.status}`,
+    );
+    void consumer.onEvent(event).catch((error: unknown) => {
+      console.error(`[transition-dispatch] onEvent() failed for issueId=${transition.issueId}:`, error);
+    });
+  });
+}
+
+export function wireReviewEligible(
+  subscriber: BoardTransitionSubscriber,
+  handler: ReviewTransitionHandler,
+): void {
+  subscriber.on("review-eligible", (transition: BoardTransitionEvent) => {
+    console.log(
+      `[transition-review] issueId=${transition.issueId} ${transition.previousStatus ?? "(cold-start)"} -> ${transition.status}`,
+    );
+    void handler.onReviewEligible(transition).catch((error: unknown) => {
+      console.error(`[transition-review] handler failed for issueId=${transition.issueId}:`, error);
+    });
+  });
+}
