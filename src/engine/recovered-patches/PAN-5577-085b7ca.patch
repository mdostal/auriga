@@ -0,0 +1,75 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseRoleTreeConfig, resolveRole } from "./role-tree.ts";
+
+test("role-tree resolves the deepest declarative match", () => {
+  const tree = parseRoleTreeConfig(`
+roles:
+  - role: engineering
+    assignee:
+      type: agent
+      name: auriga-dev
+    children:
+      - role: verification
+        match:
+          labelsAll: [verify]
+          titleIncludes: [live]
+        assignee:
+          type: agent
+          id: verifier-agent-id
+`);
+
+  const resolution = resolveRole(tree, {
+    id: "issue-1",
+    title: "Live dispatch verification",
+    labels: ["verify"],
+  });
+
+  assert.deepEqual(resolution, {
+    rolePath: ["engineering", "verification"],
+    assignee: { type: "agent", id: "verifier-agent-id" },
+  });
+});
+
+test("role-tree falls back to the parent role when no child matches", () => {
+  const tree = parseRoleTreeConfig({
+    roles: [
+      {
+        role: "engineering",
+        assignee: { type: "agent", name: "auriga-dev" },
+        children: [
+          {
+            role: "docs",
+            match: { labelsAll: ["docs"] },
+            assignee: { type: "agent", name: "technical-writer" },
+          },
+        ],
+      },
+    ],
+  });
+
+  const resolution = resolveRole(tree, {
+    id: "issue-1",
+    title: "Implement dispatch",
+    labels: ["backend"],
+  });
+
+  assert.deepEqual(resolution, {
+    rolePath: ["engineering"],
+    assignee: { type: "agent", name: "auriga-dev" },
+  });
+});
+
+test("role-tree returns null when no declarative match exists", () => {
+  const tree = parseRoleTreeConfig({
+    roles: [
+      {
+        role: "docs",
+        match: { labelsAll: ["docs"] },
+        assignee: { type: "agent", name: "technical-writer" },
+      },
+    ],
+  });
+
+  assert.equal(resolveRole(tree, { id: "issue-1", labels: ["backend"] }), null);
+});
