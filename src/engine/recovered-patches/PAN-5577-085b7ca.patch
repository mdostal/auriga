@@ -0,0 +1,152 @@
+import * as yaml from "js-yaml";
+import { z } from "zod";
+
+export const MulticaAssigneeTypeSchema = z.enum(["agent", "squad"]);
+export type MulticaAssigneeType = z.infer<typeof MulticaAssigneeTypeSchema>;
+
+export const RoleTreeAssigneeSchema = z.object({
+  type: MulticaAssigneeTypeSchema,
+  id: z.string().optional(),
+  name: z.string().optional(),
+}).refine((assignee) => Boolean(assignee.id || assignee.name), {
+  message: "role-tree assignee requires either id or name",
+});
+export type RoleTreeAssignee = z.infer<typeof RoleTreeAssigneeSchema>;
+
+export const RoleTreeMatchSchema = z.object({
+  types: z.array(z.string()).optional(),
+  sources: z.array(z.string()).optional(),
+  statuses: z.array(z.string()).optional(),
+  priorities: z.array(z.string()).optional(),
+  titleIncludes: z.array(z.string()).optional(),
+  descriptionIncludes: z.array(z.string()).optional(),
+  labelsAny: z.array(z.string()).optional(),
+  labelsAll: z.array(z.string()).optional(),
+  metadata: z.record(z.string(), z.union([z.string(), z.number(), z.boolean(), z.null()])).optional(),
+});
+export type RoleTreeMatch = z.infer<typeof RoleTreeMatchSchema>;
+
+export interface RoleTreeTask {
+  id: string;
+  type?: string;
+  source?: string;
+  title?: string;
+  description?: string;
+  status?: string;
+  priority?: string;
+  labels?: string[];
+  metadata?: Record<string, string | number | boolean | null>;
+}
+
+export interface RoleTreeNode {
+  role: string;
+  assignee?: RoleTreeAssignee;
+  match?: RoleTreeMatch;
+  children?: RoleTreeNode[];
+}
+
+export interface RoleTreeConfig {
+  roles: RoleTreeNode[];
+}
+
+export interface RoleResolution {
+  rolePath: string[];
+  assignee: RoleTreeAssignee;
+}
+
+const RoleTreeNodeSchema: z.ZodType<RoleTreeNode> = z.lazy(() =>
+  z.object({
+    role: z.string().min(1),
+    assignee: RoleTreeAssigneeSchema.optional(),
+    match: RoleTreeMatchSchema.optional(),
+    children: z.array(RoleTreeNodeSchema).optional(),
+  }),
+);
+
+export const RoleTreeConfigSchema: z.ZodType<RoleTreeConfig> = z.object({
+  roles: z.array(RoleTreeNodeSchema).min(1),
+});
+
+export function parseRoleTreeConfig(input: string | unknown): RoleTreeConfig {
+  const candidate = typeof input === "string" ? yaml.load(input) : input;
+  return RoleTreeConfigSchema.parse(candidate);
+}
+
+export function resolveRole(tree: RoleTreeConfig, task: RoleTreeTask): RoleResolution | null {
+  for (const node of tree.roles) {
+    const resolution = resolveNode(node, task, []);
+    if (resolution) return resolution;
+  }
+  return null;
+}
+
+function resolveNode(
+  node: RoleTreeNode,
+  task: RoleTreeTask,
+  parentPath: string[],
+): RoleResolution | null {
+  if (node.match && !matches(node.match, task)) {
+    return null;
+  }
+
+  const rolePath = [...parentPath, node.role];
+  for (const child of node.children ?? []) {
+    const childResolution = resolveNode(child, task, rolePath);
+    if (childResolution) return childResolution;
+  }
+
+  if (node.assignee) {
+    return { rolePath, assignee: node.assignee };
+  }
+  return null;
+}
+
+function matches(match: RoleTreeMatch, task: RoleTreeTask): boolean {
+  return (
+    matchList(match.types, task.type) &&
+    matchList(match.sources, task.source) &&
+    matchList(match.statuses, task.status) &&
+    matchList(match.priorities, task.priority) &&
+    includesEvery(match.titleIncludes, task.title) &&
+    includesEvery(match.descriptionIncludes, task.description) &&
+    labelsAny(match.labelsAny, task.labels) &&
+    labelsAll(match.labelsAll, task.labels) &&
+    metadataMatches(match.metadata, task.metadata)
+  );
+}
+
+function matchList(needles: string[] | undefined, value: string | undefined): boolean {
+  if (!needles || needles.length === 0) return true;
+  if (!value) return false;
+  return needles.includes(value);
+}
+
+function includesEvery(needles: string[] | undefined, value: string | undefined): boolean {
+  if (!needles || needles.length === 0) return true;
+  if (!value) return false;
+  const haystack = value.toLowerCase();
+  return needles.every((needle) => haystack.includes(needle.toLowerCase()));
+}
+
+function labelsAny(needles: string[] | undefined, labels: string[] | undefined): boolean {
+  if (!needles || needles.length === 0) return true;
+  if (!labels) return false;
+  const available = new Set(labels);
+  return needles.some((needle) => available.has(needle));
+}
+
+function labelsAll(needles: string[] | undefined, labels: string[] | undefined): boolean {
+  if (!needles || needles.length === 0) return true;
+  if (!labels) return false;
+  const available = new Set(labels);
+  return needles.every((needle) => available.has(needle));
+}
+
+function metadataMatches(
+  expected: Record<string, string | number | boolean | null> | undefined,
+  actual: Record<string, string | number | boolean | null> | undefined,
+): boolean {
+  if (!expected) return true;
+  if (!actual) return false;
+  return Object.entries(expected).every(([key, value]) => actual[key] === value);
+}
