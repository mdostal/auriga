index 0000000..67155ce
--- /dev/null
+++ b/auriga/consumer/decision-emission.test.ts
@@ -0,0 +1,178 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import type { EventContract } from "../../contracts/event.ts";
+import type { ClaimResult, LockContract } from "../../contracts/lock.ts";
+import type {
+  LockResult,
+  TaskRecord,
+  TaskStatus,
+  TrackerAdapter,
+} from "../../contracts/tracker-adapter.ts";
+import {
+  AurigaConsumer,
+  type DispatchDecisionMetric,
+  type DispatchDecisionRecord,
+  type DispatchDecisionSink,
+} from "./index.ts";
+
+class FakeLock implements LockContract {
+  claimResult: ClaimResult = { ok: true, leaseId: "lease-1" };
+
+  async claim(_taskId: string): Promise<ClaimResult> {
+    return this.claimResult;
+  }
+  async renew(_leaseId: string): Promise<boolean> {
+    return true;
+  }
+  async release(_leaseId: string): Promise<void> {
+    // no-op
+  }
+  async sweep(): Promise<string[]> {
+    return [];
+  }
+}
+
+class FakeTrackerAdapter implements TrackerAdapter {
+  updateStatusCalls: { taskId: string; status: TaskStatus }[] = [];
+
+  async claimTask(_taskId: string): Promise<LockResult> {
+    return { claimed: true, lockId: "fake-lock-id", expiresAt: null };
+  }
+  async updateStatus(taskId: string, status: TaskStatus): Promise<void> {
+    this.updateStatusCalls.push({ taskId, status });
+  }
+  async getTask(taskId: string): Promise<TaskRecord> {
+    return { id: taskId, status: "pending", title: "fake task" };
+  }
+}
+
+class CapturingDispatchDecisionSink implements DispatchDecisionSink {
+  decisions: DispatchDecisionRecord[] = [];
+  metrics: DispatchDecisionMetric[] = [];
+
+  async emitDecision(record: DispatchDecisionRecord): Promise<void> {
+    this.decisions.push(record);
+  }
+  async emitMetric(metric: DispatchDecisionMetric): Promise<void> {
+    this.metrics.push(metric);
+  }
+}
+
+class ThrowingDispatchDecisionSink implements DispatchDecisionSink {
+  async emitDecision(_record: DispatchDecisionRecord): Promise<void> {
+    throw new Error("simulated decision sink failure");
+  }
+  async emitMetric(_metric: DispatchDecisionMetric): Promise<void> {
+    throw new Error("simulated metric sink failure");
+  }
+}
+
+function makeEvent(overrides: Partial<EventContract> = {}): EventContract {
+  return {
+    id: randomUUID(),
+    type: "task.claimable",
+    payload: { taskId: `task-${randomUUID()}` },
+    timestamp: new Date().toISOString(),
+    source: "test-fixture",
+    ...overrides,
+  };
+}
+
+test("dispatch decision emission: successful dispatch records chosen lane, reason, alternatives, and an L1-shaped metric", async () => {
+  const lock = new FakeLock();
+  const trackerAdapter = new FakeTrackerAdapter();
+  const sink = new CapturingDispatchDecisionSink();
+  const consumer = new AurigaConsumer(lock, trackerAdapter, sink);
+  const event = makeEvent({
+    id: "evt-success",
+    payload: { taskId: "task-success" },
+  });
+
+  await consumer.onEvent(event);
+
+  assert.equal(sink.decisions.length, 1);
+  assert.equal(sink.metrics.length, 1);
+  assert.deepEqual(trackerAdapter.updateStatusCalls, [
+    { taskId: "task-success", status: "in_progress" },
+  ]);
+
+  const decision = sink.decisions[0]!;
+  assert.equal(decision.eventId, "evt-success");
+  assert.equal(decision.taskId, "task-success");
+  assert.equal(decision.outcome, "dispatched");
+  assert.equal(decision.chosenLane, "trackerAdapter.updateStatus");
+  assert.equal(decision.reason, "claim_succeeded");
+  assert.deepEqual(decision.alternatives, [
+    {
+      lane: "none",
+      reason: "claim_rejected_already_claimed",
+    },
+  ]);
+  assert.equal(Number.isNaN(Date.parse(decision.timestamp)), false);
+
+  const metric = sink.metrics[0]!;
+  assert.match(metric.event_id, /^evt_dispatch_decision_/);
+  assert.equal(metric.metric_type, "auriga.dispatch.decision");
+  assert.equal(metric.value, 1);
+  assert.equal(metric.unit, "count");
+  assert.equal(metric.source, "auriga.consumer");
+  assert.deepEqual(metric.dimensions, {
+    event_id: "evt-success",
+    task_id: "task-success",
+    outcome: "dispatched",
+    chosen_lane: "trackerAdapter.updateStatus",
+    reason: "claim_succeeded",
+  });
+});
+
+test("dispatch decision emission: already-claimed tasks emit a no-dispatch decision and metric", async () => {
+  const lock = new FakeLock();
+  lock.claimResult = { ok: false, reason: "already_claimed" };
+  const trackerAdapter = new FakeTrackerAdapter();
+  const sink = new CapturingDispatchDecisionSink();
+  const consumer = new AurigaConsumer(lock, trackerAdapter, sink);
+
+  await consumer.onEvent(
+    makeEvent({
+      id: "evt-claimed",
+      payload: { taskId: "task-claimed" },
+    }),
+  );
+
+  assert.equal(trackerAdapter.updateStatusCalls.length, 0);
+  assert.equal(sink.decisions.length, 1);
+  assert.equal(sink.metrics.length, 1);
+  assert.equal(sink.decisions[0]!.outcome, "skipped");
+  assert.equal(sink.decisions[0]!.chosenLane, "none");
+  assert.equal(sink.decisions[0]!.reason, "claim_rejected_already_claimed");
+  assert.deepEqual(sink.decisions[0]!.alternatives, [
+    {
+      lane: "trackerAdapter.updateStatus",
+      reason: "requires_successful_claim",
+    },
+  ]);
+  assert.equal(sink.metrics[0]!.dimensions.outcome, "skipped");
+});
+
+test("dispatch decision emission: a missing sink is safe and a throwing sink does not break dispatch", async () => {
+  const lock = new FakeLock();
+  const trackerAdapter = new FakeTrackerAdapter();
+  const withoutSink = new AurigaConsumer(lock, trackerAdapter);
+
+  await assert.doesNotReject(() =>
+    withoutSink.onEvent(makeEvent({ payload: { taskId: "task-noop" } })),
+  );
+
+  const throwingSink = new ThrowingDispatchDecisionSink();
+  const withThrowingSink = new AurigaConsumer(lock, trackerAdapter, throwingSink);
+
+  await assert.doesNotReject(() =>
+    withThrowingSink.onEvent(makeEvent({ payload: { taskId: "task-throwing-sink" } })),
+  );
+
+  assert.deepEqual(trackerAdapter.updateStatusCalls, [
+    { taskId: "task-noop", status: "in_progress" },
+    { taskId: "task-throwing-sink", status: "in_progress" },
+  ]);
+});
