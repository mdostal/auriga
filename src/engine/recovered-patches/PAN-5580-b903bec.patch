   error: unknown;
 }
 
+export type DispatchDecisionOutcome = "dispatched" | "skipped" | "failed";
+
+export type DispatchDecisionReason =
+  | "claim_succeeded"
+  | "claim_rejected_already_claimed"
+  | "lock_claim_failed"
+  | "tracker_dispatch_failed";
+
+export interface DispatchAlternative {
+  lane: string;
+  reason: string;
+}
+
+export interface DispatchDecisionRecord {
+  decisionId: string;
+  timestamp: string;
+  source: "auriga.consumer";
+  eventId: string;
+  taskId: string;
+  outcome: DispatchDecisionOutcome;
+  chosenLane: string;
+  reason: DispatchDecisionReason;
+  alternatives: DispatchAlternative[];
+}
+
+/**
+ * L1-shaped metric event for one dispatch/routing decision. The field
+ * names intentionally mirror the existing `.pHive/metrics/events/*.jsonl`
+ * shape (`event_id`, `metric_type`, `value`, `unit`, `dimensions`,
+ * `source`) so Argus/KPI ingestion can consume the same contract once it
+ * exists. This module only emits; it does not depend on Argus being
+ * present.
+ */
+export interface DispatchDecisionMetric {
+  event_id: string;
+  timestamp: string;
+  metric_type: "auriga.dispatch.decision";
+  value: 1;
+  unit: "count";
+  dimensions: {
+    event_id: string;
+    task_id: string;
+    outcome: DispatchDecisionOutcome;
+    chosen_lane: string;
+    reason: DispatchDecisionReason;
+  };
+  source: "auriga.consumer";
+}
+
+export interface DispatchDecisionSink {
+  emitDecision(record: DispatchDecisionRecord): Promise<void> | void;
+  emitMetric(metric: DispatchDecisionMetric): Promise<void> | void;
+}
+
+const noopDispatchDecisionSink: DispatchDecisionSink = {
+  emitDecision(_record: DispatchDecisionRecord): void {
+    // no-op until an Argus/KPI sink is wired.
+  },
+  emitMetric(_metric: DispatchDecisionMetric): void {
+    // no-op until an Argus/KPI sink is wired.
+  },
+};
+
 /**
