+  async #emitDispatchDecision(
+    event: EventContract,
+    taskId: string,
+    decision: Pick<
+      DispatchDecisionRecord,
+      "outcome" | "chosenLane" | "reason" | "alternatives"
+    >,
+  ): Promise<void> {
+    const timestamp = new Date().toISOString();
+    const record: DispatchDecisionRecord = {
+      decisionId: `dispatch_decision_${event.id}_${taskId}_${timestamp}`,
+      timestamp,
+      source: "auriga.consumer",
+      eventId: event.id,
+      taskId,
+      ...decision,
+    };
+    const metric: DispatchDecisionMetric = {
+      event_id: `evt_dispatch_decision_${event.id}_${taskId}_${timestamp}`,
+      timestamp,
+      metric_type: "auriga.dispatch.decision",
+      value: 1,
+      unit: "count",
+      dimensions: {
+        event_id: event.id,
+        task_id: taskId,
+        outcome: record.outcome,
+        chosen_lane: record.chosenLane,
+        reason: record.reason,
+      },
+      source: "auriga.consumer",
+    };
+
+    try {
+      await this.#dispatchDecisionSink.emitDecision(record);
+    } catch {
+      // Argus/KPI emission must be no-op safe until that sink exists.
+    }
+
+    try {
+      await this.#dispatchDecisionSink.emitMetric(metric);
+    } catch {
+      // Argus/KPI emission must be no-op safe until that sink exists.
+    }
+  }
+
   /**
