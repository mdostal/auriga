+++ b/auriga/routing/index.ts
@@ -0,0 +1,232 @@
+import { z } from "zod";
+
+const LaneStatusValueSchema = z.enum(["up", "down", "out_of_credit", "degraded"]);
+const SignalSourceSchema = z.enum(["passive", "public_status", "active_probe"]);
+
+export type LaneStatusValue = z.infer<typeof LaneStatusValueSchema>;
+export type SignalSource = z.infer<typeof SignalSourceSchema>;
+
+export const HeimdallLaneStatusSchema = z.object({
+  lane_id: z.string(),
+  provider: z.string(),
+  status: LaneStatusValueSchema,
+  reset_at: z.string().nullable(),
+  reason: z.string().nullable(),
+  last_updated: z.string(),
+  signal_source: SignalSourceSchema,
+  account_id: z.string().optional(),
+  runtime_id: z.string().optional(),
+  task_types: z.array(z.string()).optional(),
+  available_headroom: z.number().optional(),
+  model_tier: z.string().optional(),
+});
+export type HeimdallLaneStatus = z.infer<typeof HeimdallLaneStatusSchema>;
+
+const HeimdallLaneStatusesSchema = z.array(HeimdallLaneStatusSchema);
+
+export interface LaneRouterClient {
+  listLanes(): Promise<HeimdallLaneStatus[]>;
+}
+
+export interface HeimdallHttpLaneRouterClientOptions {
+  baseUrl: string;
+  fetchImpl?: typeof fetch;
+}
+
+export class HeimdallHttpLaneRouterClient implements LaneRouterClient {
+  readonly #baseUrl: string;
+  readonly #fetchImpl: typeof fetch;
+
+  constructor(options: HeimdallHttpLaneRouterClientOptions) {
+    this.#baseUrl = options.baseUrl.replace(/\/+$/, "");
+    this.#fetchImpl = options.fetchImpl ?? fetch;
+  }
+
+  async listLanes(): Promise<HeimdallLaneStatus[]> {
+    const res = await this.#fetchImpl(`${this.#baseUrl}/lanes`);
+    if (!res.ok) {
+      throw new Error(`HeimdallHttpLaneRouterClient.listLanes failed (${res.status})`);
+    }
+    return HeimdallLaneStatusesSchema.parse(await res.json());
+  }
+}
+
+export interface DispatchRoutingRequest {
+  taskId: string;
+  taskType: string;
+  requiredHeadroom: number;
+  allowedModelTiers?: string[];
+}
+
+export interface ConsideredLane {
+  lane_id: string;
+  provider: string;
+  status: LaneStatusValue;
+  eligible: boolean;
+  reasons: string[];
+}
+
+export interface RoutingDecisionRecord {
+  taskId: string;
+  taskType: string;
+  requiredHeadroom: number;
+  selectedLane: HeimdallLaneStatus | null;
+  consideredLanes: ConsideredLane[];
+  decision: "selected" | "blocked";
+  reason: string;
+  timestamp: string;
+}
+
+export type RoutingDecision = RoutingDecisionRecord;
+
+export interface DecisionRecorder {
+  recordRoutingDecision(record: RoutingDecisionRecord): Promise<void> | void;
+}
+
+export interface RoutingEngine {
+  selectLane(request: DispatchRoutingRequest): Promise<RoutingDecision>;
+}
+
+export class ConsoleDecisionRecorder implements DecisionRecorder {
+  recordRoutingDecision(record: RoutingDecisionRecord): void {
+    console.log(JSON.stringify({ type: "auriga.routing_decision", ...record }));
+  }
+}
+
+class NoopDecisionRecorder implements DecisionRecorder {
+  recordRoutingDecision(_record: RoutingDecisionRecord): void {
+    // Intentionally empty.
+  }
+}
+
+export interface HealthAwareRoutingEngineOptions {
+  now?: () => string;
+}
+
+interface EligibleLane {
+  lane: HeimdallLaneStatus;
+  considered: ConsideredLane;
+}
+
+const CHEAP_MODEL_TIERS = new Set(["cheap", "economy", "low_cost", "low-cost"]);
+const DEFAULT_ALLOWED_MODEL_TIERS = new Set(["standard", "premium", "high", "pro"]);
+
+export class HealthAwareRoutingEngine implements RoutingEngine {
+  readonly #client: LaneRouterClient;
+  readonly #recorder: DecisionRecorder;
+  readonly #now: () => string;
+
+  constructor(
+    client: LaneRouterClient,
+    recorder: DecisionRecorder = new NoopDecisionRecorder(),
+    options: HealthAwareRoutingEngineOptions = {},
+  ) {
+    this.#client = client;
+    this.#recorder = recorder;
+    this.#now = options.now ?? (() => new Date().toISOString());
+  }
+
+  async selectLane(request: DispatchRoutingRequest): Promise<RoutingDecision> {
+    const lanes = await this.#client.listLanes();
+    const eligible: EligibleLane[] = [];
+    const consideredLanes = lanes.map((lane) => {
+      const considered = this.#considerLane(lane, request);
+      if (considered.eligible) {
+        eligible.push({ lane, considered });
+      }
+      return considered;
+    });
+
+    eligible.sort((a, b) => compareEligibleLanes(a.lane, b.lane));
+
+    const selectedLane = eligible[0]?.lane ?? null;
+    const decision: RoutingDecision = {
+      taskId: request.taskId,
+      taskType: request.taskType,
+      requiredHeadroom: normalizeRequiredHeadroom(request.requiredHeadroom),
+      selectedLane,
+      consideredLanes,
+      decision: selectedLane ? "selected" : "blocked",
+      reason: selectedLane
+        ? `selected lane ${selectedLane.lane_id}`
+        : "no eligible lane available",
+      timestamp: this.#now(),
+    };
+
+    await this.#recorder.recordRoutingDecision(decision);
+    return decision;
+  }
+
+  #considerLane(lane: HeimdallLaneStatus, request: DispatchRoutingRequest): ConsideredLane {
+    const reasons: string[] = [];
+    const requiredHeadroom = normalizeRequiredHeadroom(request.requiredHeadroom);
+
+    if (lane.status !== "up") {
+      reasons.push("lane_not_up");
+    }
+
+    if (
+      lane.task_types &&
+      !lane.task_types.includes("*") &&
+      !lane.task_types.includes(request.taskType)
+    ) {
+      reasons.push("task_type_not_supported");
+    }
+
+    if (
+      typeof lane.available_headroom === "number" &&
+      lane.available_headroom < requiredHeadroom
+    ) {
+      reasons.push("insufficient_headroom");
+    }
+
+    if (!isModelTierAllowed(lane.model_tier, request.allowedModelTiers)) {
+      reasons.push("model_tier_not_allowed");
+    }
+
+    return {
+      lane_id: lane.lane_id,
+      provider: lane.provider,
+      status: lane.status,
+      eligible: reasons.length === 0,
+      reasons,
+    };
+  }
+}
+
+function normalizeRequiredHeadroom(requiredHeadroom: number): number {
+  if (!Number.isFinite(requiredHeadroom) || requiredHeadroom <= 0) {
+    return 1;
+  }
+  return requiredHeadroom;
+}
+
+function isModelTierAllowed(modelTier: string | undefined, allowedModelTiers: string[] | undefined): boolean {
+  if (!modelTier) {
+    return true;
+  }
+
+  const normalizedModelTier = modelTier.toLowerCase();
+  const allowed = allowedModelTiers
+    ? new Set(allowedModelTiers.map((tier) => tier.toLowerCase()))
+    : DEFAULT_ALLOWED_MODEL_TIERS;
+
+  if (allowed.has(normalizedModelTier)) {
+    return true;
+  }
+
+  if (!allowedModelTiers && CHEAP_MODEL_TIERS.has(normalizedModelTier)) {
+    return false;
+  }
+
+  return allowedModelTiers === undefined;
+}
+
+function compareEligibleLanes(a: HeimdallLaneStatus, b: HeimdallLaneStatus): number {
+  const aHeadroom = a.available_headroom ?? Number.POSITIVE_INFINITY;
+  const bHeadroom = b.available_headroom ?? Number.POSITIVE_INFINITY;
+  if (aHeadroom !== bHeadroom) {
+    return bHeadroom - aHeadroom;
+  }
+  return a.lane_id.localeCompare(b.lane_id);
+}
