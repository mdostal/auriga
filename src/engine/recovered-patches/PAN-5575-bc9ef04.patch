+test("claim-then-route-then-dispatch: a successful claim queries the routing engine before dispatch", async () => {
+  const lock = new FakeLock();
+  lock.claimResult = { ok: true, leaseId: "lease-1" };
+  const trackerAdapter = new FakeTrackerAdapter();
+  const selectedLane: HeimdallLaneStatus = {
+    lane_id: "codex-primary",
+    provider: "codex",
+    status: "up",
+    reset_at: null,
+    reason: null,
+    last_updated: "2026-07-27T00:00:00.000Z",
+    signal_source: "active_probe",
+    available_headroom: 5,
+  };
+  const routingEngine = new FakeRoutingEngine({
+    taskId: "task-routed",
+    taskType: "coding",
+    requiredHeadroom: 2,
+    selectedLane,
+    consideredLanes: [],
+    decision: "selected",
+    reason: "selected lane codex-primary",
+    timestamp: "2026-07-27T00:00:00.000Z",
+  });
+  const consumer = new AurigaConsumer(lock, trackerAdapter, { routingEngine });
+
+  const event = makeEvent({
+    payload: {
+      taskId: "task-routed",
+      taskType: "coding",
+      requiredHeadroom: 2,
+    },
+  });
+  await consumer.onEvent(event);
+
+  assert.deepEqual(routingEngine.requests, [
+    {
+      taskId: "task-routed",
+      taskType: "coding",
+      requiredHeadroom: 2,
+      allowedModelTiers: undefined,
+    },
+  ]);
+  assert.deepEqual(trackerAdapter.updateStatusCalls, [
+    { taskId: "task-routed", status: "in_progress" },
+  ]);
+});
+
+test("claim-then-route-blocked: no eligible lane marks the task blocked instead of dispatching", async () => {
+  const lock = new FakeLock();
+  lock.claimResult = { ok: true, leaseId: "lease-1" };
+  const trackerAdapter = new FakeTrackerAdapter();
+  const routingEngine = new FakeRoutingEngine({
+    taskId: "task-blocked",
+    taskType: "coding",
+    requiredHeadroom: 1,
+    selectedLane: null,
+    consideredLanes: [],
+    decision: "blocked",
+    reason: "no eligible lane",
+    timestamp: "2026-07-27T00:00:00.000Z",
+  });
+  const consumer = new AurigaConsumer(lock, trackerAdapter, { routingEngine });
+
+  await consumer.onEvent(
+    makeEvent({
+      payload: { task_id: "task-blocked", task_type: "coding" },
+    }),
+  );
+
+  assert.deepEqual(routingEngine.requests, [
+    {
+      taskId: "task-blocked",
+      taskType: "coding",
+      requiredHeadroom: 1,
+      allowedModelTiers: undefined,
+    },
+  ]);
+  assert.deepEqual(trackerAdapter.updateStatusCalls, [
+    { taskId: "task-blocked", status: "blocked" },
+  ]);
+});
+
