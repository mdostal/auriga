+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  HealthAwareRoutingEngine,
+  HeimdallHttpLaneRouterClient,
+  type DecisionRecorder,
+  type HeimdallLaneStatus,
+  type LaneRouterClient,
+  type RoutingDecisionRecord,
+} from "./index.ts";
+
+class FakeLaneRouterClient implements LaneRouterClient {
+  constructor(private readonly lanes: HeimdallLaneStatus[]) {}
+
+  async listLanes(): Promise<HeimdallLaneStatus[]> {
+    return this.lanes;
+  }
+}
+
+class RecordingDecisionRecorder implements DecisionRecorder {
+  readonly records: RoutingDecisionRecord[] = [];
+
+  async recordRoutingDecision(record: RoutingDecisionRecord): Promise<void> {
+    this.records.push(record);
+  }
+}
+
+function lane(overrides: Partial<HeimdallLaneStatus>): HeimdallLaneStatus {
+  return {
+    lane_id: "codex-primary",
+    provider: "codex",
+    status: "up",
+    reset_at: null,
+    reason: null,
+    last_updated: "2026-07-27T00:00:00.000Z",
+    signal_source: "active_probe",
+    ...overrides,
+  };
+}
+
+test("selectLane chooses an up lane that matches task type and headroom, excluding cheap tiers by default", async () => {
+  const recorder = new RecordingDecisionRecorder();
+  const engine = new HealthAwareRoutingEngine(
+    new FakeLaneRouterClient([
+      lane({
+        lane_id: "codex-cheap",
+        provider: "codex",
+        model_tier: "cheap",
+        task_types: ["coding"],
+        available_headroom: 100,
+      }),
+      lane({
+        lane_id: "claude-wrong-task",
+        provider: "claude",
+        task_types: ["writing"],
+        available_headroom: 12,
+      }),
+      lane({
+        lane_id: "codex-too-full",
+        provider: "codex",
+        task_types: ["coding"],
+        available_headroom: 1,
+      }),
+      lane({
+        lane_id: "codex-primary",
+        provider: "codex",
+        model_tier: "standard",
+        task_types: ["coding"],
+        available_headroom: 6,
+        account_id: "mathew",
+        runtime_id: "hive-runtime-1",
+      }),
+    ]),
+    recorder,
+    { now: () => "2026-07-27T01:00:00.000Z" },
+  );
+
+  const decision = await engine.selectLane({
+    taskId: "task-123",
+    taskType: "coding",
+    requiredHeadroom: 4,
+  });
+
+  assert.equal(decision.selectedLane?.lane_id, "codex-primary");
+  assert.equal(decision.decision, "selected");
+  assert.equal(recorder.records.length, 1);
+  assert.equal(recorder.records[0]?.selectedLane?.runtime_id, "hive-runtime-1");
+  assert.equal(recorder.records[0]?.consideredLanes.length, 4);
+  assert.ok(
+    recorder.records[0]?.consideredLanes.some(
+      (candidate) =>
+        candidate.lane_id === "codex-cheap" &&
+        candidate.eligible === false &&
+        candidate.reasons.includes("model_tier_not_allowed"),
+    ),
+  );
+});
+
+test("selectLane never selects down or out_of_credit lanes and records a blocked decision", async () => {
+  const recorder = new RecordingDecisionRecorder();
+  const engine = new HealthAwareRoutingEngine(
+    new FakeLaneRouterClient([
+      lane({ lane_id: "claude-down", provider: "claude", status: "down" }),
+      lane({ lane_id: "codex-empty", provider: "codex", status: "out_of_credit" }),
+    ]),
+    recorder,
+    { now: () => "2026-07-27T02:00:00.000Z" },
+  );
+
+  const decision = await engine.selectLane({
+    taskId: "task-456",
+    taskType: "coding",
+    requiredHeadroom: 1,
+  });
+
+  assert.equal(decision.selectedLane, null);
+  assert.equal(decision.decision, "blocked");
+  assert.match(decision.reason, /no eligible lane/i);
+  assert.deepEqual(
+    recorder.records[0]?.consideredLanes.map((candidate) => [
+      candidate.lane_id,
+      candidate.eligible,
+      candidate.reasons,
+    ]),
+    [
+      ["claude-down", false, ["lane_not_up"]],
+      ["codex-empty", false, ["lane_not_up"]],
+    ],
+  );
+});
+
+test("HeimdallHttpLaneRouterClient fetches and validates the /lanes contract", async () => {
+  const fetchCalls: string[] = [];
+  const client = new HeimdallHttpLaneRouterClient({
+    baseUrl: "http://heimdall.local/",
+    fetchImpl: (async (url: string) => {
+      fetchCalls.push(url);
+      return {
+        ok: true,
+        status: 200,
+        json: async () => [
+          lane({
+            lane_id: "claude@mathew",
+            provider: "claude",
+            status: "up",
+          }),
+        ],
+      } as Response;
+    }) as typeof fetch,
+  });
+
+  const lanes = await client.listLanes();
+
+  assert.deepEqual(fetchCalls, ["http://heimdall.local/lanes"]);
+  assert.equal(lanes[0]?.lane_id, "claude@mathew");
+});
